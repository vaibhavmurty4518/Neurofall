# NeuroFall 2.0 Environment Configuration
FLASK_ENV=development
PORT=5000

# Optional: AI Provider Key for NeuroFall Intelligence Live Reasoning
# If omitted, NeuroFall uses its built-in data-grounded clinical analysis engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Emergency SMS / Calling Gateway
# If omitted, system runs in Demo Mode and clearly indicates "Notification provider not configured"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
